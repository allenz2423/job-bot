# Gmail integration configuration for the local job bot, using the Gmail REST API.
# The bot will expose narrow local tools over this adapter; no Gmail MCP endpoint is needed.
# Copy this file to config/gmail.env and fill in values as needed.
# Keep the OAuth client JSON and generated token file out of git.

# Leave disabled until the OAuth client and user consent flow are configured.
GMAIL_ENABLED=false

# OAuth credentials from a Google Cloud Desktop app client.
# Keep the client secret private; do not commit config/gmail.env.
GMAIL_OAUTH_CLIENT_TYPE=desktop
GMAIL_OAUTH_CLIENT_ID=replace-with-google-oauth-client-id
GMAIL_OAUTH_CLIENT_SECRET=replace-with-google-oauth-client-secret

# Created by the local OAuth flow after you grant consent. Treat as a secret.
GMAIL_TOKEN_FILE=secrets/gmail/token.json

# Gmail API's special identifier for the account that authorized OAuth.
GMAIL_USER_ID=me

# Read-only access; this still grants access to mailbox messages broadly.
GMAIL_SCOPES=https://www.googleapis.com/auth/gmail.readonly

# Narrow Google Drive scope for the spreadsheet created/selected by this app.
GOOGLE_SHEETS_SCOPE=https://www.googleapis.com/auth/drive.file

# Poll interval for employer updates.
GMAIL_POLL_INTERVAL_SECONDS=300
GMAIL_SYNC_MAX_MESSAGES=100
GMAIL_DB_PATH=state/jobbot.sqlite3

# Add a Gmail label/filter for relevant employer messages before enabling.
# Example Gmail query: label:job-bot-updates newer_than:30d
GMAIL_SEARCH_QUERY=label:job-bot-updates newer_than:30d

# Verification codes may be surfaced for a human handoff only.
GMAIL_OTP_HANDOFF_ONLY=true
GMAIL_OTP_AUTO_SUBMIT=false
