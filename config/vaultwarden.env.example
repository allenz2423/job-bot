# Bitwarden CLI API login for the Vaultwarden-compatible server.
# Copy to config/vaultwarden.env and fill in the personal API credentials.
BW_SERVER_URL=https://your-vaultwarden.example
BW_CLIENTID=replace-with-personal-client-id
BW_CLIENTSECRET=replace-with-personal-client-secret

# The API key logs the CLI in but does not decrypt the vault. Unlock separately;
# do not put the account master password in this file.
