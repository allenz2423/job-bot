FROM python:3.12-slim

ENV PYTHONUNBUFFERED=1 \
    HF_HOME=/models/download-cache \
    TOKENIZERS_PARALLELISM=false

RUN pip install --no-cache-dir --index-url https://download.pytorch.org/whl/cpu "torch==2.14.1"
RUN pip install --no-cache-dir --index-url https://download.pytorch.org/whl/cpu "torchvision==0.29.1+cpu"
RUN pip install --no-cache-dir "sentence-transformers==6.1.0" "transformers==5.19.0" pillow

WORKDIR /app
COPY scripts/embedding_ranker_service.py /app/embedding_ranker_service.py
USER 1000:1000
CMD ["python", "/app/embedding_ranker_service.py"]
