# Set these to the host account that owns the mounted state and OAuth files.
JOB_BOT_UID=1000
JOB_BOT_GID=1000

# Web UI is local-only by default. Set WEB_HOST_BIND=0.0.0.0 only after
# reviewing DOCKER.md and setting the exact acknowledgment shown there.
WEB_HOST_BIND=127.0.0.1
WEB_HOST_PORT=8080
WEB_REMOTE_BIND_ACK=

# Discovery's scheduler checks each configured job at least once per minute.
# Individual scrape-job intervals are set in Settings; provider caps still apply.
DISCOVERY_INTERVAL_SECONDS=60
# Both workers use this OpenAI-compatible local endpoint; keep it local and do not add credentials.
LOCAL_LLM_BASE_URL=http://host.docker.internal:11434/v1
# Discovery classifies public search results with Gemma 4 E2B.
LOCAL_LLM_MODEL=gemma4:e2b
# The applier interprets browser forms with Gemma 4 E4B, grounded in approved candidate facts.
APPLICATION_LLM_MODEL=gemma4:e4b
